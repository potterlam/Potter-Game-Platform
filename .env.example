# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx-yyy-123456.region.aws.neon.tech/dbname?sslmode=require

# JWT secret - use a long random string (64+ chars)
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-characters-long-ok

# Email that gets auto-promoted to admin on registration
ADMIN_EMAIL=your-admin@email.com

# Environment
NODE_ENV=development
PORT=3000

# Optional: restrict CORS origin in production
# ALLOWED_ORIGIN=https://your-app.onrender.com
